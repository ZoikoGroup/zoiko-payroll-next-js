# Zoiko Payroll Assist widget (see components/assist/AssistWidget.tsx)
#
# Public base URL of the payroll platform backend, e.g.:
#   NEXT_PUBLIC_ASSIST_API_BASE_URL=https://api.zoikopayroll.com
# For local development against the backend's dev server:
#   NEXT_PUBLIC_ASSIST_API_BASE_URL=http://127.0.0.1:8010
#
# Left unset, the Assist widget does not render — it never points at a
# guessed or broken URL.
NEXT_PUBLIC_ASSIST_API_BASE_URL=
